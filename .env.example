# Copy to .env for local runs only. Never commit .env. In production these live in GitHub repository secrets.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
COHERE_API_KEY=
# COHERE_MODEL=command-a-03-2025
# Control panel (Google Sheet + Apps Script): settings + sending. See README step 3.
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=
# Optional SMTP alternative for sending (only if not using the control panel)
GMAIL_USER=tenders@your-domain.com
GMAIL_APP_PASSWORD=
EMAIL_TO=tender-alerts@your-domain.com
